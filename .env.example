# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/ckpcet_events
DATABASE_NAME=ckpcet_events

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password
SMTP_FROM="CKPCET Events <no-reply@ckpcet.ac.in>"
